diff --git a/monado/drivers/quest2/q2_driver.c b/monado/drivers/quest2/q2_driver.c
--- a/monado/drivers/quest2/q2_driver.c
+++ b/monado/drivers/quest2/q2_driver.c
@@ -124,6 +124,8 @@
 	struct xrt_vec2 stick;
 	int64_t last_ns;
 	uint32_t last_dev_us;
+	uint64_t elapsed_us;
+	bool have_dev_us;
 	int64_t dev_offset_ns;
 	bool have_offset;
 };
@@ -258,6 +260,21 @@
 static void
 handle_ctrl_motion(struct q2_controller *c, uint32_t dev_us, const int16_t *v, int64_t now_ns)
 {
+	/* Unwrap only ordered 32-bit samples. Resets/ambiguous gaps require a
+	 * new controller clock epoch; do not manufacture a 1 ns sample. */
+	uint64_t elapsed_us = dev_us;
+	if (c->have_dev_us) {
+		uint32_t delta_us = dev_us - c->last_dev_us;
+		if (delta_us == 0 || delta_us >= UINT32_C(0x80000000) ||
+		    c->elapsed_us > (uint64_t)(INT64_MAX / 1000) - delta_us) {
+			return;
+		}
+		elapsed_us = c->elapsed_us + delta_us;
+	}
+	c->last_dev_us = dev_us;
+	c->elapsed_us = elapsed_us;
+	c->have_dev_us = true;
+
 	/* ICM-42686 at +-32 g / +-4000 dps: 1024 LSB/g, 8.2 LSB/(deg/s).
 	 * IMU -> controller (LED model) frame, from the TrackedObject
 	 * calibration: the two controllers mount their IMUs mirrored. */
@@ -271,7 +288,7 @@
 		gyro = (struct xrt_vec3){-v[3] * gs, -v[5] * gs, -v[4] * gs};
 	}
 
-	int64_t ts = map_time((int64_t)dev_us * 1000, now_ns, &c->dev_offset_ns, &c->have_offset);
+	int64_t ts = map_time((int64_t)elapsed_us * 1000, now_ns, &c->dev_offset_ns, &c->have_offset);
 	if (ts <= c->last_ns) {
 		ts = c->last_ns + 1;
 	}
@@ -310,8 +327,8 @@
 			int16_t x, y;
 			memcpy(&x, v + 1, 2);
 			memcpy(&y, v + 3, 2);
-			c->stick.x = x / 32767.0f;
-			c->stick.y = y / 32767.0f;
+			c->stick.x = x == INT16_MIN ? -1.0f : x / 32767.0f;
+			c->stick.y = y == INT16_MIN ? -1.0f : y / 32767.0f;
 			break;
 		}
 		case 0x41: {
@@ -319,7 +336,6 @@
 			int16_t m[6];
 			memcpy(&dev_us, v + 1, 4);
 			memcpy(m, v + 7, 12);
-			c->last_dev_us = dev_us;
 			handle_ctrl_motion(c, dev_us, m, now_ns);
 			break;
 		}
@@ -327,8 +343,9 @@
 			/* Motion without timestamp: the next sample (~2 ms). */
 			int16_t m[6];
 			memcpy(m, v + 1, 12);
-			c->last_dev_us += 2000;
-			handle_ctrl_motion(c, c->last_dev_us, m, now_ns);
+			if (c->have_dev_us) {
+				handle_ctrl_motion(c, c->last_dev_us + 2000u, m, now_ns);
+			}
 			break;
 		}
 		default: break;
